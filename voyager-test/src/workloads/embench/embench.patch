+    // 处理定时器中断
+    else if ((read_csr(mip) & 0x80) != 0) { // 检查MTIP
+      // 安全读取当前时间
+      unsigned long long current_time = get_mtime();
+      if(hart_id == 0){
+        timer_flags[0] += 1;
+        // 更新mtimecmp（当前时间 + 间隔0x10）
+        if(timer_flags[0] < 100){
+          // U32(0x2004000) = (unsigned int)(current_time + 0x50);     // 写入低32位
+          // U32(0x2004004) = (unsigned int)((current_time + 0x50) >> 32); // 写入高32位
+          volatile uint32_t* mtimecmp = (uint32_t*)(CLINT_BASE + TIMECMP_OFFSET(hart_id));
+          uint64_t new_cmp = get_mtime() + 0x50;
+          *(uint64_t*)mtimecmp = new_cmp; // 直接写入64位
+        }
+        // 达到条件后禁用定时器中断
+        else if (timer_flags[0] >= 100) {
+            unsigned int mie_val = read_csr(mie);
+            write_csr(mie, mie_val & ~0x80); // 清除 MTIE (Bit7)
+            // printf("Timer interrupts disabled.\n");
+            // 清除 MIE 位（Bit3）
+            unsigned int mstatus_val = read_csr(mstatus);
+            write_csr(mstatus, mstatus_val & ~0x8); 
+        }
+      }
+      else if(hart_id == 1){
+        timer_flags[1] += 1;
+        // 更新mtimecmp（当前时间 + 间隔0x10）
+        if(timer_flags[1] < 100){
+          // U32(0x2004000) = (unsigned int)(current_time + 0x50);     // 写入低32位
+          // U32(0x2004004) = (unsigned int)((current_time + 0x50) >> 32); // 写入高32位
+          volatile uint32_t* mtimecmp = (uint32_t*)(CLINT_BASE + TIMECMP_OFFSET(hart_id));
+          uint64_t new_cmp = get_mtime() + 0x50;
+          *(uint64_t*)mtimecmp = new_cmp; // 直接写入64位
+        }
+        // 达到条件后禁用定时器中断
+        else if (timer_flags[1] >= 100) {
+            unsigned int mie_val = read_csr(mie);
+            write_csr(mie, mie_val & ~0x80); // 清除 MTIE (Bit7)
+            // printf("Timer interrupts disabled.\n");
+            // 清除 MIE 位（Bit3）
+            unsigned int mstatus_val = read_csr(mstatus);
+            write_csr(mstatus, mstatus_val & ~0x8); 
+        }
+      }
+      else if(hart_id == 2){
+        timer_flags[2] += 1;
+        // 更新mtimecmp（当前时间 + 间隔0x10）
+        if(timer_flags[2] < 100){
+          // U32(0x2004000) = (unsigned int)(current_time + 0x50);     // 写入低32位
+          // U32(0x2004004) = (unsigned int)((current_time + 0x50) >> 32); // 写入高32位
+          volatile uint32_t* mtimecmp = (uint32_t*)(CLINT_BASE + TIMECMP_OFFSET(hart_id));
+          uint64_t new_cmp = get_mtime() + 0x50;
